            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "empty"
                },
                {
                  "type": "string",
                  "const": "too_long"
                },
                {
                  "type": "string",
                  "const": "mixed_script"
                },
                {
                  "type": "string",
                  "const": "moderation"
                }
              ]
            }
          }
        }
      }
    },
    "KeyResetAccepted": {
