            "type": "object",
            "required": [
              "studentId",
              "displayName"
            ],
            "properties": {
              "studentId": {
                "type": "integer"
              },
              "displayName": {
                "type": "string"
              }
            }
          }
        },
        "suspendedUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Classmates": {
      "type": "object",
      "required": [
        "className",
        "classmates"
      ],
      "properties": {
        "className": {
          "type": "string"
