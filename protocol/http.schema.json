        "studentId",
        "displayName",
        "division",
        "slot",
        "classNo",
        "className",
        "teacher",
        "startsOn",
        "classmates",
        "suspendedUntil"
      ],
      "properties": {
        "studentId": {
          "type": "integer"
        },
        "displayName": {
          "type": "string"
        },
        "division": {
          "anyOf": [
            {
              "type": "string",
              "const": "primary"
            },
            {
              "type": "string",
              "const": "junior"
            },
            {
              "type": "string",
              "const": "senior"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "type": "string",
              "const": "morning"
            },
            {
              "type": "string",
              "const": "afternoon"
            },
            {
              "type": "string",
              "const": "evening"
            }
          ]
        },
        "classNo": {
          "type": "integer"
        },
        "className": {
          "type": "string"
