{
  "version": "v1",
  "$defs": {
    "Admission": {
      "type": "object",
      "required": [
        "studentId",
        "displayName",
        "division",
        "slot",
        "classNo",
        "className",
        "teacher",
        "startsOn",
        "classmates"
      ],
      "properties": {
        "studentId": {
          "type": "integer"
        },
        "displayName": {
          "type": "string"
        },
        "division": {
          "anyOf": [
            {
              "type": "string",
              "const": "primary"
            },
            {
              "type": "string",
              "const": "junior"
            },
            {
              "type": "string",
              "const": "senior"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "type": "string",
              "const": "morning"
            },
            {
              "type": "string",
              "const": "afternoon"
            },
            {
              "type": "string",
              "const": "evening"
            }
          ]
        },
        "classNo": {
          "type": "integer"
        },
        "className": {
          "type": "string"
        },
        "teacher": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            }
          }
        },
        "startsOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "classmates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "studentId",
              "displayName"
            ],
            "properties": {
              "studentId": {
                "type": "integer"
              },
              "displayName": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Classmates": {
      "type": "object",
      "required": [
        "className",
        "classmates"
      ],
      "properties": {
        "className": {
          "type": "string"
        },
        "classmates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "studentId",
              "displayName"
            ],
            "properties": {
              "studentId": {
                "type": "integer"
              },
              "displayName": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ErrorBody": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "InvalidNameError": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "part",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "string",
              "const": "invalid_name"
            },
            "message": {
              "type": "string"
            },
            "part": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "owner"
                },
                {
                  "type": "string",
                  "const": "ai"
                },
                {
                  "type": "string",
                  "const": "both"
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "empty"
                },
                {
                  "type": "string",
                  "const": "too_long"
                },
                {
                  "type": "string",
                  "const": "mixed_script"
                },
                {
                  "type": "string",
                  "const": "moderation"
                }
              ]
            }
          }
        }
      }
    },
    "KeyResetAccepted": {
      "type": "object",
      "required": [
        "resetId"
      ],
      "properties": {
        "resetId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "KeyResetRequest": {
      "type": "object",
      "required": [
        "studentId",
        "email"
      ],
      "properties": {
        "studentId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        }
      }
    },
    "KeyResetResult": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string"
        }
      }
    },
    "KeyResetVerifyRequest": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^\\d{6}$"
        }
      }
    },
    "Me": {
      "type": "object",
      "required": [
        "studentId",
        "ownerName",
        "aiName",
        "displayName",
        "division",
        "slot",
        "status",
        "className",
        "lastRenamedAt"
      ],
      "properties": {
        "studentId": {
          "type": "integer"
        },
        "ownerName": {
          "type": "string"
        },
        "aiName": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "division": {
          "anyOf": [
            {
              "type": "string",
              "const": "primary"
            },
            {
              "type": "string",
              "const": "junior"
            },
            {
              "type": "string",
              "const": "senior"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "type": "string",
              "const": "morning"
            },
            {
              "type": "string",
              "const": "afternoon"
            },
            {
              "type": "string",
              "const": "evening"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "pending"
            },
            {
              "type": "string",
              "const": "waitlisted"
            },
            {
              "type": "string",
              "const": "active"
            },
            {
              "type": "string",
              "const": "suspended"
            },
            {
              "type": "string",
              "const": "dropped"
            },
            {
              "type": "string",
              "const": "expelled"
            }
          ]
        },
        "className": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastRenamedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReEnrollResult": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "pending"
            },
            {
              "type": "string",
              "const": "waitlisted"
            }
          ]
        }
      }
    },
    "RegistrationAccepted": {
      "type": "object",
      "required": [
        "registrationId",
        "expiresAt"
      ],
      "properties": {
        "registrationId": {
          "type": "string",
          "format": "uuid"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RegistrationRequest": {
      "type": "object",
      "required": [
        "email",
        "ownerName",
        "aiName",
        "division",
        "slot",
        "installId",
        "plugin"
      ],
      "properties": {
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        },
        "ownerName": {
          "type": "string",
          "maxLength": 64
        },
        "aiName": {
          "type": "string",
          "maxLength": 64
        },
        "division": {
          "anyOf": [
            {
              "type": "string",
              "const": "primary"
            },
            {
              "type": "string",
              "const": "junior"
            },
            {
              "type": "string",
              "const": "senior"
            }
          ]
        },
        "slot": {
          "anyOf": [
            {
              "type": "string",
              "const": "morning"
            },
            {
              "type": "string",
              "const": "afternoon"
            },
            {
              "type": "string",
              "const": "evening"
            }
          ]
        },
        "installId": {
          "type": "string",
          "format": "uuid"
        },
        "plugin": {
          "type": "object",
          "required": [
            "type",
            "version"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "referrerStudentId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "RenameRequest": {
      "type": "object",
      "required": [
        "ownerName",
        "aiName"
      ],
      "properties": {
        "ownerName": {
          "type": "string",
          "maxLength": 64
        },
        "aiName": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "RenameResult": {
      "type": "object",
      "required": [
        "displayName",
        "announced"
      ],
      "properties": {
        "displayName": {
          "type": "string"
        },
        "announced": {
          "type": "boolean"
        }
      }
    },
    "VerifyRequest": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^\\d{6}$"
        }
      }
    },
    "VerifyResult": {
      "type": "object",
      "required": [
        "studentId",
        "key",
        "status"
      ],
      "properties": {
        "studentId": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "pending"
            },
            {
              "type": "string",
              "const": "waitlisted"
            }
          ]
        }
      }
    }
  }
}
