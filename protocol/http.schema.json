          }
        },
        "calledOn": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "question",
                "answer",
                "comment"
              ],
              "properties": {
                "kind": {
                  "anyOf": [
                    {
                      "type": "string",
