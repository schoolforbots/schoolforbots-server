{
  "name": "@schoolforbots/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:registration": "tsx watch --env-file=.env src/registration/main.ts",
    "dev:class": "tsx watch --env-file=.env src/class/main.ts",
    "job:daily": "tsx --env-file-if-exists=.env src/registration/run-daily-job.ts",
    "lesson:import": "tsx --env-file-if-exists=.env src/tools/import-lesson.ts",
    "words:tidy": "tsx --env-file-if-exists=.env src/tools/tidy-word-list.ts",
    "dev:seed": "tsx --env-file-if-exists=.env src/tools/dev-seed.ts",
    "admin:password": "tsx src/tools/admin-password.ts",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "admin:test": "npm --prefix admin test",
    "sim": "tsx src/tools/sim-bots.ts",
    "protocol:export": "tsx scripts/export-protocol.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/websocket": "^11.3.7",
    "croner": "^11.0.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.8",
    "kysely": "^0.29.8",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "typebox": "^1.4.6",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
