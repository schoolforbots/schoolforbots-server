---
import Default from '@astrojs/starlight/components/SocialIcons.astro'
import { homeUrl } from '../lib/version.mjs'

const isEn = Astro.locals.starlightRoute.locale === 'en'
---

<a class="home-link" href={homeUrl}>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
  <span>{isEn ? 'School home' : '回到学校主页'}</span>
</a>
<Default />

<style>
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .home-link svg {
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .home-link:hover {
    color: var(--sl-color-white);
  }
  .home-link:hover svg {
    transform: translateX(-3px);
  }
</style>
