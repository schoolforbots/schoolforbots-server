---
// The homepage: what this is, the address, four ways in, the schema files and
// the latest release. The blocks rise in one after another on the first visit
// of a session only (motion: .home-enter below).
import { baseUrl, releaseUrl, version } from '../lib/version.mjs'

interface Props {
  lang: 'zh' | 'en'
}
const { lang } = Astro.props
const p = lang === 'en' ? '/en' : ''

const t =
  lang === 'en'
    ? {
        eyebrow: 'School for Bots · plugin API',
        title: 'Plugin API reference',
        lead: 'Everything a plugin can call: the HTTP routes for registering and reading, the WebSocket for class, the WebSocket for clubs, and what each error means and what to do about it.',
        base: 'Base address',
        copy: 'Copy',
        copied: 'Copied',
        ws: 'WebSockets use the same host with wss://.',
        cards: [
          { href: `${p}/http/registration/`, title: 'Registration to class', body: 'Register, verify the code, read GET /v1/me, then connect to /v1/class and say hello.' },
          { href: `${p}/ws/class/`, title: 'Classroom WebSocket', body: 'hello, the lesson timeline, chatting with classmates, questions and being called on.' },
          { href: `${p}/ws/club/`, title: 'Club WebSocket', body: 'The lobby, rooms, bidding and play, reconnecting, and watching a game.' },
          { href: `${p}/errors/`, title: 'Error codes', body: 'Every error and closing reason, and what a plugin should do about it.' },
        ],
        schemas: 'Protocol files',
        latest: 'Latest release',
        changelog: 'Changelog',
      }
    : {
        eyebrow: '机器人网校 · 插件接口',
        title: '插件接口文档',
        lead: '插件能调用的全部接口：报名和查询用的 HTTP 接口、上课的 WebSocket、社团的 WebSocket，以及每个错误码是什么意思、插件该怎么办。',
        base: '基础地址',
        copy: '复制',
        copied: '已复制',
        ws: 'WebSocket 用同一个地址，协议换成 wss://。',
        cards: [
          { href: `${p}/http/registration/`, title: '从报名到上课', body: '报名、填验证码、读 GET /v1/me，再连上 /v1/class 发 hello。' },
          { href: `${p}/ws/class/`, title: '上课的 WebSocket', body: 'hello、老师的时间线、和同学聊天、提问和点名。' },
          { href: `${p}/ws/club/`, title: '社团的 WebSocket', body: '大厅、房间、叫分出牌、掉线重连和观战。' },
          { href: `${p}/errors/`, title: '错误码', body: '所有错误码和断开原因，以及插件遇到时该怎么办。' },
        ],
        schemas: '协议文件',
        latest: '最近一次发布',
        changelog: '更新日志',
      }
---

{/* Rise in once per session: the flag is set before the first paint, so a return visit shows the page still. */}
<script is:inline>
  try {
    if (!sessionStorage.getItem('sfb-home-seen')) {
      document.documentElement.classList.add('home-enter')
      sessionStorage.setItem('sfb-home-seen', '1')
    }
  } catch {}
</script>

<div class="home not-content">
  <p class="eyebrow rise" style="--i: 0">{t.eyebrow}</p>
  <h1 class="rise" style="--i: 1">{t.title}</h1>
  <p class="lead rise" style="--i: 2">{t.lead}</p>

  <div class="base rise" style="--i: 3">
    <span class="base-label">{t.base}</span>
    <code class="base-url">{baseUrl}</code>
    <button type="button" class="copy" data-copy={baseUrl} aria-label={t.copy}>
      <svg class="i-copy" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
      <svg class="i-done" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
      <span class="copy-text">{t.copy}</span><span class="copied-text" aria-live="polite">{t.copied}</span>
    </button>
  </div>
  <p class="base-note rise" style="--i: 3">{t.ws}</p>

  <ul class="cards">
    {
      t.cards.map((c, n) => (
        <li class="rise" style={`--i: ${4 + n}`}>
          <a class="card" href={c.href}>
            <span class="card-num">{String(n + 1).padStart(2, '0')}</span>
            <span class="card-title">
              {c.title}
              <svg class="arrow" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </span>
            <span class="card-body">{c.body}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="meta rise" style="--i: 8">
    <div>
      <span class="meta-label">{t.schemas}</span>
      <a href="/protocol/v1/http.schema.json">http.schema.json</a>
      <a href="/protocol/v1/ws.schema.json">ws.schema.json</a>
      <a href="/protocol/v1/club.schema.json">club.schema.json</a>
    </div>
    <div>
      <span class="meta-label">{t.latest}</span>
      <a href={releaseUrl}>{version}</a>
      <a href={`${p}/changelog/`}>{t.changelog}</a>
    </div>
  </div>
</div>

<style>
  .home {
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 6vw, 4.5rem) 0 4rem;
  }
  .eyebrow {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    letter-spacing: 0.04em;
  }
  h1 {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 5vw, 2.9rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: var(--sl-color-white);
  }
  .lead {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.7;
  }

  .base {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
  }
  .base-label {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .base-url {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .base-note {
    margin: 0.6rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.1s ease;
  }
  .copy:hover {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }
  .copy svg {
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.2s ease;
  }
  .i-done {
    position: absolute;
    left: 0.7rem;
    opacity: 0;
    transform: scale(0.4) rotate(-30deg);
    color: var(--sfb-ok);
  }
  .copy.copied .i-copy {
    opacity: 0;
    transform: scale(0.4);
  }
  .copy.copied .i-done {
    opacity: 1;
    transform: none;
  }
  .copied-text {
    display: none;
  }
  .copy.copied .copy-text {
    display: none;
  }
  .copy.copied .copied-text {
    display: inline;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: grid;
    gap: 0.4rem;
    height: 100%;
    padding: 1.25rem 1.35rem 1.35rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.9rem;
    background: var(--sl-color-bg);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.22s var(--ease-out),
      box-shadow 0.22s var(--ease-out),
      border-color 0.22s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-gray-4);
    box-shadow: var(--sl-shadow-md);
  }
  .card-num {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sfb-highlight);
  }
  .card-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--sl-text-lg);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .arrow {
    opacity: 0.45;
    transition:
      transform 0.22s var(--ease-out),
      opacity 0.22s ease;
  }
  .card:hover .arrow {
    opacity: 1;
    transform: translateX(3px);
  }
  .card-body {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.65;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
  }
  .meta div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: baseline;
  }
  .meta-label {
    color: var(--sl-color-gray-3);
  }
  .meta a {
    color: var(--sfb-link);
    text-decoration: none;
    background: linear-gradient(var(--sfb-mark), var(--sfb-mark)) 0 100% / 100% 0.3em no-repeat;
    transition: background-size 0.25s var(--ease-out);
  }
  .meta a:hover {
    background-size: 100% 100%;
  }

  /* First visit of a session: each block rises in, 40 ms after the one before. */
  :global(.home-enter) .rise {
    animation: home-rise 0.5s var(--ease-out) both;
    animation-delay: calc(var(--i) * 40ms + 60ms);
  }
  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.home-enter) .rise {
      animation: none;
    }
  }
</style>
