---
import Default from '@astrojs/starlight/components/Sidebar.astro'
---

<Default><slot /></Default>
{/*
  The current page is marked by one block behind the sidebar links rather than
  each link's own background, so that on moving to another page the block slides
  from the old item to the new (its view-transition-name in motion.css). Placed
  by an inline script right after the sidebar, before the first paint; without
  script the link keeps its own background.
*/}
<script is:inline>
  ;(() => {
    const nav = document.querySelector('nav.sidebar .top-level')
    if (!nav) return
    const mark = document.createElement('span')
    mark.className = 'sidebar-mark'
    mark.setAttribute('aria-hidden', 'true')
    nav.prepend(mark)
    nav.classList.add('has-sidebar-mark')
    const place = () => {
      const current = nav.querySelector('a[aria-current="page"]')
      if (!current || !current.offsetParent) {
        mark.hidden = true
        return
      }
      const a = current.getBoundingClientRect()
      const box = nav.getBoundingClientRect()
      mark.hidden = false
      mark.style.transform = `translate(${a.left - box.left}px, ${a.top - box.top}px)`
      mark.style.width = `${a.width}px`
      mark.style.height = `${a.height}px`
    }
    place()
    new ResizeObserver(place).observe(nav)
  })()
</script>
