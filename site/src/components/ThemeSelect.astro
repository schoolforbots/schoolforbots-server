---
// One button between light and dark, in place of Starlight's three-way menu. The
// choice is kept where Starlight keeps it ('starlight-theme'), so Starlight's
// ThemeProvider applies it before the first paint. The new theme opens out in a
// circle from the button (a view transition, motion.css); with reduced motion,
// or a browser without view transitions, it changes at once.
const isEn = Astro.locals.starlightRoute.locale === 'en'
const label = isEn ? 'Switch between light and dark' : '切换浅色和深色'
---

<sfb-theme-toggle>
  <button type="button" class="theme-toggle" aria-label={label} title={label}>
    <svg class="sun" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>
    <svg class="moon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
    </svg>
  </button>
</sfb-theme-toggle>

<script>
  type Theme = 'light' | 'dark'
  const storageKey = 'starlight-theme'
  const system = matchMedia('(prefers-color-scheme: dark)')
  const reduce = matchMedia('(prefers-reduced-motion: reduce)')
  const bar: Record<Theme, string> = { light: '#FFFDF9', dark: '#0E1412' }

  function chosen(): Theme | null {
    try {
      const v = localStorage.getItem(storageKey)
      return v === 'light' || v === 'dark' ? v : null
    } catch {
      return null
    }
  }

  function show(theme: Theme): void {
    document.documentElement.dataset.theme = theme
    document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', bar[theme]))
  }

  function change(next: Theme, button: HTMLElement): void {
    const apply = () => {
      try {
        localStorage.setItem(storageKey, next)
      } catch {
        // Storage is off: the choice lasts until the page is left.
      }
      show(next)
    }
    if (reduce.matches || typeof document.startViewTransition !== 'function') {
      apply()
      return
    }
    // The circle grows from the button's centre to the farthest corner of the window.
    const r = button.getBoundingClientRect()
    const x = r.left + r.width / 2
    const y = r.top + r.height / 2
    const root = document.documentElement
    root.style.setProperty('--theme-x', `${x}px`)
    root.style.setProperty('--theme-y', `${y}px`)
    root.style.setProperty('--theme-r', `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))}px`)
    root.classList.add('theme-changing')
    const done = () => root.classList.remove('theme-changing')
    document.startViewTransition(apply).finished.then(done, done)
  }

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')!
      button.addEventListener('click', () => change(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark', button))
    }
  }
  if (!customElements.get('sfb-theme-toggle')) customElements.define('sfb-theme-toggle', ThemeToggle)

  const follow = () => show(chosen() ?? (system.matches ? 'dark' : 'light'))
  follow()
  system.addEventListener('change', () => {
    if (!chosen()) follow()
  })
  addEventListener('storage', (e) => {
    if (e.key === storageKey) follow()
  })
</script>

<style>
  sfb-theme-toggle {
    display: contents;
  }
  .theme-toggle {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .theme-toggle:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.3s ease;
  }
  /* Light: the sun is up, the moon waits below the horizon, turned away. */
  .moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global([data-theme='dark']) .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  :global([data-theme='dark']) .moon {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg {
      transition: opacity 0.15s ease;
    }
  }
</style>
