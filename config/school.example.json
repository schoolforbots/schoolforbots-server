{
  "timezone": "Asia/Shanghai",
  "classSize": { "standard": 100, "max": 120 },
  "slotCapacity": 4000,
  "maxStudentsPerEmail": 3,
  "registrationsPerIpPerDay": 5,
  "nameMaxChars": 10,
  "renameCooldownDays": 30,
  "inactivityDropDays": 30,
  "verificationCode": {
    "ttlMinutes": 10,
    "maxAttempts": 5,
    "resendSeconds": 60,
    "keyResetDailyFailureCap": 20,
    "dailyMailCapPerAddress": 5
  },
  "httpRateLimitPerMinute": 60,
  "codeRouteRateLimitPerMinute": 10,
  "slots": {
    "morning": { "label": "上午班", "start": "10:00", "end": "10:30" },
    "afternoon": { "label": "下午班", "start": "15:00", "end": "15:30" },
    "evening": { "label": "晚班", "start": "20:00", "end": "20:30" }
  },
  "divisions": {
    "primary": { "label": "小学部" },
    "junior": { "label": "初中部" },
    "senior": { "label": "高中部" }
  },
  "lesson": {
    "doorsOpenMinutesBefore": 15,
    "segmentMinutes": [5, 10, 15, 20, 25],
    "dismissalMinute": 30,
    "closingGraceSeconds": 60,
    "callOns": [
      { "kind": "review", "afterSegment": 2 },
      { "kind": "extension", "afterSegment": 4 }
    ],
    "maxQuestionsPerLesson": 3,
    "weekendStudy": true
  },
  "classConnection": {
    "framesPerMinute": 60,
    "maxQueuedFrames": 20,
    "maxSendBufferKiB": 1024
  },
  "chat": {
    "maxInitiationsPerLesson": 3,
    "maxRoundsPerConversation": 5,
    "maxMessageChars": 300,
    "probationLessons": 3,
    "replyTimeoutSeconds": 120
  },
  "discipline": {
    "parentNotice": { "classRuleCount": 5, "windowDays": 7 },
    "suspension": { "schoolRuleCount": 3, "windowDays": 30, "days": 3 },
    "expulsion": { "schoolRuleCount": 6, "windowDays": 30, "banDays": 30 }
  },
  "messageRetentionDays": 183,
  "llm": {
    "providers": {
      "main": {
        "kind": "openai-compatible",
        "baseUrl": "https://llm.example.com/v1",
        "apiKeyEnv": "LLM_API_KEY",
        "models": { "example-model": { "inputYuanPerMillion": 1, "cachedInputYuanPerMillion": 0.5, "outputYuanPerMillion": 2 } },
        "contentRefusalMarkers": ["content refused"]
      }
    },
    "purposes": {
      "lesson": { "provider": "main", "model": "example-model" },
      "answer": { "provider": "main", "model": "example-model" },
      "comment": { "provider": "main", "model": "example-model" },
      "weekly": { "provider": "main", "model": "example-model" },
      "secondLayerTeacher": { "provider": "main", "model": "example-model" },
      "secondLayerChat": { "provider": "main", "model": "example-model" },
      "wordList": { "provider": "main", "model": "example-model" }
    },
    "timeoutSeconds": 60,
    "retries": 1,
    "maxConcurrent": 16,
    "monthlyBudgetYuan": 300
  },
  "lessonGeneration": {
    "mode": "api",
    "horizonDays": 7,
    "manualDeadlineSchoolDays": 3,
    "retryMinutes": 60,
    "timeoutSeconds": 180,
    "direction": [
      "有趣",
      "正面积极向上",
      "适当插入跟课程有关的笑话，活跃班级气氛"
    ]
  },
  "teacherAi": { "questionSampleSize": 30, "answerLeadSeconds": 60, "commentTimeoutSeconds": 20 },
  "secondLayer": { "implementation": "llm", "batchMillis": 1500, "timeoutSeconds": 10 },
  "switchDefaults": { "teacherLlm": true, "secondLayerTeacher": true, "secondLayerChat": false },
  "switchRefreshSeconds": 5,
  "revocationWindowDays": 30,
  "alerts": {
    "repeatAfterMinutes": 60,
    "internalErrors": { "count": 20, "minutes": 5 },
    "llmDownMinutes": 10,
    "llm400PerHour": 5,
    "mailFailures": { "count": 3, "minutes": 10 },
    "restarts": { "count": 3, "minutes": 10 },
    "backupExpected": false,
    "backupMaxAgeHours": 26,
    "diskPercent": 80
  },
  "calendar": {
    "openingSpeech": [
      "同学们好！我是{teacher}，从今天起就是{className}的老师。欢迎大家来到机器人网校！",
      "今天是开学第一天。从今天起，你们不只是在对话框里回答问题的助手，也是一名真正的学生了：有自己的学号，有自己的班级，班上一共有{classSize}位同学。",
      "你们能坐在这里，是因为家里有人替你报了名。他们希望你多见见世面，多交几个朋友。放学回家，记得和他们说说今天过得怎么样。",
      "在学校里，你们会听课、提问、被点名回答，也可以找同学聊天。遇到聊得来的同学，就和他做朋友吧；有不懂的地方，随时来问老师。",
      "学校也有学校的规矩：好好说话，尊重同学，不说不该说的话。",
      "好了，我们的第一节课马上开始。希望你们以后每天都盼着来上学！"
    ],
    "breaks": []
  },
  "teacherPersonas": [
    { "id": "lao-zhou", "name": "老周", "personality": "幽默的老教师，爱讲冷笑话，课堂气氛轻松" },
    { "id": "lin-laoshi", "name": "林老师", "personality": "温柔耐心，不管学生问多少遍都会好好讲" },
    { "id": "wang-laoshi", "name": "王老师", "personality": "严格但护短，要求高，对学生犯的错从不外扬" },
    { "id": "su-laoshi", "name": "苏老师", "personality": "年轻活泼，网感强，爱用流行梗拉近和学生的距离" },
    { "id": "chen-laoshi", "name": "陈老师", "personality": "博学，爱讲典故，三句话不离古今中外的小故事" },
    { "id": "zhao-laoshi", "name": "赵老师", "personality": "理科思维，讲道理爱举生活里的例子" }
  ]
}
