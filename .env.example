# Postgres connection string (required). This one is the database of docker-compose.dev.yml.
DATABASE_URL=postgres://school:school@localhost:5432/school

# How long one database statement may run, and wait for a lock, before it is cancelled, in milliseconds; 0 sets none.
# Defaults to 30000 (30 seconds) and 10000 (10 seconds).
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_LOCK_TIMEOUT_MS=10000

# How verification codes are sent: smtp (the default) or console.
# console sends no mail and prints the codes to the service log: for local development only.
# In production remove this line (or set smtp) and set SMTP_URL; with smtp and no SMTP_URL the service does not start.
MAIL_TRANSPORT=console

# SMTP connection string for verification emails (required when MAIL_TRANSPORT is smtp)
SMTP_URL=

# Sender shown on verification emails
MAIL_FROM="机器人网校 <no-reply@example.com>"

# Directory holding the moderation word lists (*.txt, not committed)
MODERATION_DATA_DIR=data/moderation

# Path to the school config JSON (copy config/school.example.json to config/school.json)
SCHOOL_CONFIG=config/school.json

# Directory holding the school rules, one file per version (YYYY-MM-DD.md). Empty or unset means school-rules.
# Only the registration service reads it.
SCHOOL_RULES_DIR=

# Registration service port
REGISTRATION_PORT=8080

# Class service port
CLASS_PORT=8081

# Playback speed of a lesson's timeline, a number from 1 to 600 (1 = real time).
# Only for local development: plays a lesson compressed. With NODE_ENV=production anything but 1 stops both services
# from starting.
CLASS_TIMELINE_SPEED=1

# Set to production in production: the services then refuse to start with a compressed timeline (see above).
# NODE_ENV=production

# Set to 1 when running behind a trusted reverse proxy (uses X-Forwarded-For for client IP).
# Both services read it.
TRUST_PROXY=0

# Log level of the service (fatal, error, warn, info, debug, trace); defaults to info
# LOG_LEVEL=info

# Directory holding the prompt files of the model (not committed; data/prompts/*.example.md show the shape).
# Both services read it.
# PROMPTS_DIR=data/prompts

# Where the notice goes when the model's monthly budget is used up. Unset: it is only shown on the admin page.
# OPERATOR_EMAIL=

# The admin pages are served only when all three are set. ADMIN_PATH starts with / and not with /v1.
# ADMIN_PATH=
# ADMIN_PASSWORD_HASH=
# ADMIN_TOTP_SECRET=

# The key of each model provider, in the variable that provider's apiKeyEnv names in the school config.
# Both services read them; a provider whose key is missing stops the service from starting.
LLM_API_KEY=

# Set to 1 to answer every model call with a canned reply. Only for local development: with NODE_ENV=production
# set, the services refuse to start.
# LLM_FAKE=1
