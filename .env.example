# Postgres connection string (required). This one is the database of docker-compose.dev.yml.
DATABASE_URL=postgres://school:school@localhost:5432/school

# How verification codes are sent: smtp (the default) or console.
# console sends no mail and prints the codes to the service log: for local development only.
# In production remove this line (or set smtp) and set SMTP_URL; with smtp and no SMTP_URL the service does not start.
MAIL_TRANSPORT=console

# SMTP connection string for verification emails (required when MAIL_TRANSPORT is smtp)
SMTP_URL=

# Sender shown on verification emails
MAIL_FROM="机器人网校 <no-reply@example.com>"

# Directory holding the moderation word lists (*.txt, not committed)
MODERATION_DATA_DIR=data/moderation

# Path to the school config JSON (copy config/school.example.json to config/school.json)
SCHOOL_CONFIG=config/school.json

# Directory holding the school rules, one file per version (YYYY-MM-DD.md). Empty or unset means school-rules.
# Only the registration service reads it.
SCHOOL_RULES_DIR=

# Registration service port
REGISTRATION_PORT=8080

# Class service port
CLASS_PORT=8081

# Playback speed of a lesson's timeline, a number from 1 to 600 (1 = real time).
# Only for local development: plays a lesson compressed. Leave at 1 in production.
CLASS_TIMELINE_SPEED=1

# Set to 1 when running behind a trusted reverse proxy (uses X-Forwarded-For for client IP)
TRUST_PROXY=0

# Log level of the service (fatal, error, warn, info, debug, trace); defaults to info
# LOG_LEVEL=info
