# The backup service's settings: the backup.env that sits next to compose.yml on the server. Copy this file to
# backup.env and fill it in; never commit it. Only the backup service reads it: the storage key can delete backups (old
# ones are deleted after BACKUP_KEEP_DAYS), so it is kept away from the registration and class services, which face the
# internet. The backup service takes DATABASE_URL from .env. Values containing $ need single quotes around them. See
# "Backups" in README.en.md.

# The PUBLIC key from `age-keygen`; keep the private key off this server.
BACKUP_AGE_RECIPIENT=

# The storage: any S3-compatible service (for example Cloudflare R2), and an access key that may read, write and delete
# objects in the bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Backups older than this many days are deleted (14 by default), and the time of the daily run, Shanghai time.
# BACKUP_KEEP_DAYS=14
# BACKUP_AT=03:30
