# The .env that sits next to compose.yml on the server. Copy this file to .env and fill it in; never commit the .env.
# Compose reads it for its own variables, and passes it to the registration and class services as their environment.
# Values containing $ need single quotes around them. The root .env.example describes the service variables in more
# detail.

# The image tag deploy.sh last deployed (it rewrites this line).
IMAGE_TAG=latest

# The school's domain; Caddy gets its certificate for it.
SCHOOL_DOMAIN=school.example.org

# The folder on the server holding the real school.json, prompts/ and moderation/. It is mounted read-only into both
# services.
SCHOOL_PRIVATE_DIR=/srv/school/private

# The database password, and the same password in DATABASE_URL (the host is the service name, postgres).
POSTGRES_PASSWORD=
DATABASE_URL=postgres://school:CHANGE-ME@postgres:5432/school

NODE_ENV=production
LOG_LEVEL=info

# How verification codes are mailed: SMTP_URL is the connection string, MAIL_FROM the sender shown.
MAIL_TRANSPORT=smtp
SMTP_URL=
MAIL_FROM="机器人网校 <no-reply@school.example.org>"

# The key of the model provider, in the variable the apiKeyEnv of school.json names. Leave LLM_FAKE out of production.
LLM_API_KEY=

# Where the operator is mailed the notice that the model's monthly budget is used up (optional).
# OPERATOR_EMAIL=

# The admin pages, served only when all three are set (see the root .env.example for how to make them).
# ADMIN_PATH=
# ADMIN_PASSWORD_HASH=
# ADMIN_TOTP_SECRET=

# Optional: other ports for the proxy on this machine (80 and 443 by default).
# HTTP_PORT=80
# HTTPS_PORT=443
